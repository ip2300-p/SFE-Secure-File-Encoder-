<Window x:Class="SFE.UI.Views.ScenariosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SFE.UI"
        Title="{Binding [ScenariosTitle], Source={StaticResource Lang}}"
        Height="720" Width="920"
        Background="{StaticResource SurfaceCrustBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <ObjectDataProvider x:Key="Lang" ObjectType="{x:Type local:LangProvider}" MethodName="get_Instance"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ ستون چپ: لیست سناریوها ═══ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding [ScenariosTitle], Source={StaticResource Lang}}"
                       Style="{StaticResource TitleStyle}" Margin="4,0,0,16"/>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                <ListBox x:Name="ScenarioList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="ScenarioList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,4">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource LabelStyle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Mode}" Foreground="{StaticResource AccentBlueBrush}" FontSize="11" Margin="0,0,8,0"/>
                                    <TextBlock Style="{StaticResource MutedStyle}" Foreground="{StaticResource TextSecondaryBrush}">
                                        <TextBlock.Text>
                                            <Binding Path="LastRunAt" StringFormat="{}{0:yyyy/MM/dd}"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceOverlayBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{Binding [NewScenario], Source={StaticResource Lang}}"
                        Style="{StaticResource PrimaryBtn}" Click="NewScenario_Click"/>
                <Button Grid.Column="2" Style="{StaticResource DangerBtn}" Click="DeleteScenario_Click"
                        Padding="0" Height="38">
                    <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                          Fill="{StaticResource TextInverseBrush}" Width="18" Height="18" Stretch="Uniform"/>
                </Button>
            </Grid>
        </Grid>

        <!-- ═══ ستون راست: ویرایش سناریو ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="EditorTitle"
                       Text="{Binding [SelectOrCreate], Source={StaticResource Lang}}"
                       Style="{StaticResource SubtitleStyle}" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,16"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                <StackPanel x:Name="EditorPanel" Margin="0,0,8,0">

                    <!-- نام سناریو -->
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding [ScenarioName], Source={StaticResource Lang}}" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBox x:Name="NameBox"/>
                        </StackPanel>
                    </Border>

                    <!-- حالت -->
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding [OperationType], Source={StaticResource Lang}}" Style="{StaticResource SectionTitleStyle}"/>
                            <ComboBox x:Name="ModeCombo">
                                <ComboBoxItem Content="{Binding [ModeEncrypt], Source={StaticResource Lang}}"/>
                                <ComboBoxItem Content="{Binding [ModeDecrypt], Source={StaticResource Lang}}"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- مسیرهای مبدا -->
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding [SourcePaths], Source={StaticResource Lang}}" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Background="{StaticResource SurfaceCrustBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" 
                                    BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,0,8">
                                <ListBox x:Name="SourcePathsList" Background="Transparent" BorderThickness="0"
                                         MinHeight="80" MaxHeight="120" FontSize="12">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceOverlayBrush}" CornerRadius="6" Padding="6,4" Margin="2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" 
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <Button Grid.Column="1" Click="RemoveSinglePath_Click"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0">
                                                        <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                              Fill="{StaticResource AccentRedBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{Binding [AddFile], Source={StaticResource Lang}}"
                                        Style="{StaticResource SecondaryBtn}" Height="38" Click="AddFile_Click"/>
                                <Button Grid.Column="2" Content="{Binding [AddFolder], Source={StaticResource Lang}}"
                                        Style="{StaticResource SecondaryBtn}" Height="38" Click="AddFolder_Click"/>
                                <Button Grid.Column="4" Content="{Binding [RemoveSelected], Source={StaticResource Lang}}"
                                        Style="{StaticResource DangerBtn}" Height="38" Click="RemovePath_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- مسیر مقصد -->
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding [OutputFolder], Source={StaticResource Lang}}" Style="{StaticResource SectionTitleStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OutputBox" IsReadOnly="True"/>
                                <Button Grid.Column="2" Content="{Binding [SelectBtn], Source={StaticResource Lang}}"
                                        Style="{StaticResource SecondaryBtn}" Width="80" Click="SelectOutput_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- تنظیمات پیشرفته -->
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding [Settings], Source={StaticResource Lang}}" Style="{StaticResource SectionTitleStyle}"/>
                            <CheckBox x:Name="RandomizeCheck" Style="{StaticResource Check}"
                                      Content="{Binding [RandomizeName], Source={StaticResource Lang}}"/>
                            <StackPanel Margin="20,4,0,8">
                                    <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=RandomizeCheck}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    </Style.Triggers>
                                    </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding [NameStyle], Source={StaticResource Lang}}" Style="{StaticResource MutedStyle}"
                                    Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="NameStyleCombo">
                                    <ComboBoxItem Content="{Binding [NameStyleCache], Source={StaticResource Lang}}" ToolTip="{Binding [NameStyleCacheDesc], Source={StaticResource Lang}}"/>
                                    <ComboBoxItem Content="{Binding [NameStyleData], Source={StaticResource Lang}}" ToolTip="{Binding [NameStyleDataDesc], Source={StaticResource Lang}}"/>
                                    <ComboBoxItem Content="{Binding [NameStyleGuid], Source={StaticResource Lang}}" ToolTip="{Binding [NameStyleGuidDesc], Source={StaticResource Lang}}"/>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox x:Name="DeleteOriginalCheck" Style="{StaticResource Check}"
                                      Content="{Binding [DeleteOriginal], Source={StaticResource Lang}}"/>
                            <CheckBox x:Name="SecureDeleteCheck" Style="{StaticResource Check}"
                            Content="{Binding [SecureDelete], Source={StaticResource Lang}}"
                            ToolTip="{Binding [SecureDeleteDesc], Source={StaticResource Lang}}"/>
                            <CheckBox x:Name="CreateBackupCheck" Style="{StaticResource Check}"
                                      Content="{Binding [CreateBackup], Source={StaticResource Lang}}"/>
                            <StackPanel Margin="20,4,0,8">
                            <StackPanel.Style>
                            <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=CreateBackupCheck}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            </Style.Triggers>
                            </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding [BackupPath], Source={StaticResource Lang}}" Style="{StaticResource MutedStyle}"
                            Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BackupPathBox" IsReadOnly="True" FontSize="11"/>
                                    <Button Grid.Column="2" Content="{Binding [SelectPath], Source={StaticResource Lang}}"
                                            Style="{StaticResource SecondaryBtn}" Width="80" Click="SelectBackup_Click"/>
                                </Grid>
                            </StackPanel>
                            <CheckBox x:Name="SecondPasswordCheck" Style="{StaticResource Check}"
                                      Content="{Binding [SecondPasswordCheck], Source={StaticResource Lang}}"/>
                            <Separator Background="{StaticResource SurfaceOverlayBrush}" Margin="0,10"/>
                            <TextBlock Text="{Binding [FileFilter], Source={StaticResource Lang}}" Style="{StaticResource MutedStyle}" 
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="FilterPresetCombo" SelectionChanged="FilterPreset_Changed">
                                <ComboBoxItem Content="{Binding [FilterAll], Source={StaticResource Lang}}"/>
                                <ComboBoxItem Content="{Binding [FilterImages], Source={StaticResource Lang}}"/>
                                <ComboBoxItem Content="{Binding [FilterVideos], Source={StaticResource Lang}}"/>
                                <ComboBoxItem Content="{Binding [FilterDocs], Source={StaticResource Lang}}"/>
                                <ComboBoxItem Content="{Binding [FilterCustom], Source={StaticResource Lang}}"/>
                            </ComboBox>
                            <Grid Margin="0,6,0,0">
                                <TextBox x:Name="CustomFilterBox" Visibility="Collapsed" FontSize="11"
                                        ToolTip="{Binding [FilterHint], Source={StaticResource Lang}}"/>
                                <TextBlock Text="{Binding [FilterPlaceholder], Source={StaticResource Lang}}"
                                        Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                        VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Text, ElementName=CustomFilterBox}" Value=""/>
                                                        <Condition Binding="{Binding Visibility, ElementName=CustomFilterBox}" Value="Visible"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- دکمه‌های پایانی -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SaveBtn" Grid.Column="0"
                        Content="{Binding [SaveScenario], Source={StaticResource Lang}}"
                        Style="{StaticResource PrimaryBtn}" Click="SaveScenario_Click"
                        IsEnabled="False" Padding="20,0" MinWidth="100"/>
                <Button x:Name="RunBtn" Grid.Column="2"
                        Content="{Binding [RunScenario], Source={StaticResource Lang}}"
                        Style="{StaticResource GreenBtn}" Click="RunScenario_Click"
                        IsEnabled="False" Padding="20,0" MinWidth="100"/>
            </Grid>
        </Grid>
    </Grid>
</Window>