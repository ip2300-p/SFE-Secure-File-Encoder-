<Window x:Class="SFE.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SFE.UI"
        Title="{Binding [SettingsTitle], Source={StaticResource Lang}}"
        Height="640" Width="480"
        Background="{StaticResource SurfaceCrustBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <ObjectDataProvider x:Key="Lang" ObjectType="{x:Type local:LangProvider}" MethodName="get_Instance"/>

        <!-- ═══ استایل ردیف‌های اطلاعات About ═══ -->
        <Style x:Key="AboutRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>

        <Style x:Key="AboutLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="AboutValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
        <StackPanel Margin="12">

            <!-- عنوان -->
            <TextBlock Text="{Binding [SettingsTitle], Source={StaticResource Lang}}"
                       Style="{StaticResource TitleStyle}" FontSize="20" Margin="4,0,0,20"/>

            <!-- ═══ کارت زبان ═══ -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding [Language], Source={StaticResource Lang}}" Style="{StaticResource SectionTitleStyle}"/>
                    <ComboBox x:Name="LanguageCombo">
                        <ComboBoxItem Content="فارسی"/>
                        <ComboBoxItem Content="English"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- ═══ کارت تغییر نام فایل ═══ -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding [OutputFilename], Source={StaticResource Lang}}" Style="{StaticResource SectionTitleStyle}"/>
                    <CheckBox x:Name="RandomizeCheck" Style="{StaticResource Check}"
                              Content="{Binding [RandomizeName], Source={StaticResource Lang}}"/>
                    <StackPanel Margin="20,10,0,0">
                        <TextBlock Text="{Binding [NameStyle], Source={StaticResource Lang}}" Style="{StaticResource SupportingStyle}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="NameStyleCombo">
                            <ComboBoxItem Content="{Binding [NameStyleCache], Source={StaticResource Lang}}" ToolTip="{Binding [NameStyleCacheDesc], Source={StaticResource Lang}}"/>
                            <ComboBoxItem Content="{Binding [NameStyleData], Source={StaticResource Lang}}" ToolTip="{Binding [NameStyleDataDesc], Source={StaticResource Lang}}"/>
                            <ComboBoxItem Content="{Binding [NameStyleGuid], Source={StaticResource Lang}}" ToolTip="{Binding [NameStyleGuidDesc], Source={StaticResource Lang}}"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ کارت عملیات فایل ═══ -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding [FileOps], Source={StaticResource Lang}}" Style="{StaticResource SectionTitleStyle}"/>
                    <CheckBox x:Name="DeleteOriginalCheck" Style="{StaticResource Check}" Content="{Binding [DeleteOriginal], Source={StaticResource Lang}}"/>
                    <CheckBox x:Name="SecureDeleteCheck" Style="{StaticResource Check}"
                    Content="{Binding [SecureDelete], Source={StaticResource Lang}}"
                    ToolTip="{Binding [SecureDeleteDesc], Source={StaticResource Lang}}"/>
                    <CheckBox x:Name="CreateBackupCheck" Style="{StaticResource Check}" Content="{Binding [CreateBackup], Source={StaticResource Lang}}"/>
                    <StackPanel Margin="20,10,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=CreateBackupCheck}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding [BackupPath], Source={StaticResource Lang}}" Style="{StaticResource SupportingStyle}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BackupPathBox" IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="{Binding [SelectPath], Source={StaticResource Lang}}"
                                    Click="SelectBackupPath_Click" Style="{StaticResource SecondaryBtn}" Height="36" Padding="14,8"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ کارت فیلتر فایل ═══ -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding [FileFilter], Source={StaticResource Lang}}" Style="{StaticResource SectionTitleStyle}"/>
                    <ComboBox x:Name="FilterPresetCombo" SelectionChanged="FilterPresetCombo_SelectionChanged">
                        <ComboBoxItem Content="{Binding [FilterAll], Source={StaticResource Lang}}"/>
                        <ComboBoxItem Content="{Binding [FilterImages], Source={StaticResource Lang}}"/>
                        <ComboBoxItem Content="{Binding [FilterVideos], Source={StaticResource Lang}}"/>
                        <ComboBoxItem Content="{Binding [FilterDocs], Source={StaticResource Lang}}"/>
                        <ComboBoxItem Content="{Binding [FilterCustom], Source={StaticResource Lang}}"/>
                    </ComboBox>
                    <Grid Margin="0,10,0,0">
                        <TextBox x:Name="CustomFilterBox" Visibility="Collapsed"
                                ToolTip="{Binding [FilterHint], Source={StaticResource Lang}}"/>
                        <TextBlock Text="{Binding [FilterPlaceholder], Source={StaticResource Lang}}"
                                Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text, ElementName=CustomFilterBox}" Value=""/>
                                                <Condition Binding="{Binding Visibility, ElementName=CustomFilterBox}" Value="Visible"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock x:Name="CustomFilterHint" Text="{Binding [FilterHint], Source={StaticResource Lang}}" 
                               Style="{StaticResource MutedStyle}" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- ═══ کارت امنیت ═══ -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding [Security], Source={StaticResource Lang}}" Style="{StaticResource SectionTitleStyle}"/>
                    <CheckBox x:Name="SecondPasswordCheck" Style="{StaticResource Check}" Content="{Binding [SecondPasswordCheck], Source={StaticResource Lang}}"/>
                    <TextBlock Text="{Binding [SecondPasswordWarn], Source={StaticResource Lang}}" 
                               Foreground="{StaticResource AccentOrangeBrush}" FontSize="11" Margin="20,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ═══ دکمه ذخیره ═══ -->
            <Button Content="{Binding [SaveSettings], Source={StaticResource Lang}}" 
                    Style="{StaticResource PrimaryBtn}" Click="SaveButton_Click" 
                    Margin="0,0,0,10" Height="44" Padding="0,12"/>

                    <!-- ═══ کارت درباره برنامه ═══ -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,10">
                    <StackPanel>
                        <!-- هدر با آیکون -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Data="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                                Fill="{StaticResource AccentBlueBrush}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding [About], Source={StaticResource Lang}}" 
                                    Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                        </StackPanel>
                        
                        <!-- نام برنامه + نسخه در یک قاب برجسته -->
                        <Border Background="{StaticResource SurfaceOverlayBrush}" 
                                CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- آیکون قفل بزرگ -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                        Background="{StaticResource AccentBlueBrush}">
                                    <Path Data="M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                                        Fill="{StaticResource TextInverseBrush}" Width="22" Height="22" Stretch="Uniform"/>
                                </Border>
                                
                                <!-- اطلاعات -->
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [AppTitle], Source={StaticResource Lang}}"
                                            FontSize="15" FontWeight="Bold" 
                                            Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="VersionText" Text="v1.0.0"
                                            FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                
                                <!-- دکمه کپی نسخه -->
                                <Button Grid.Column="2" Click="CopyVersion_Click" 
                                        ToolTip="{Binding [CopyVersion], Source={StaticResource Lang}}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Width="32" Height="32" Padding="0">
                                    <Path Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"
                                        Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>
                        
                        <!-- توضیح برنامه -->
                        <TextBlock Text="{Binding [AppDescription], Source={StaticResource Lang}}"
                                Style="{StaticResource SupportingStyle}"
                                TextWrapping="Wrap" Margin="0,0,0,12"/>
                        
                        <!-- ردیف‌های اطلاعات -->
                        <StackPanel Style="{StaticResource AboutRow}">
                            <TextBlock Text="{Binding [Developer], Source={StaticResource Lang}}" Style="{StaticResource AboutLabel}"/>
                            <TextBlock Text="{Binding [DeveloperName], Source={StaticResource Lang}}" Style="{StaticResource AboutValue}"/>
                        </StackPanel>
                        
                        <StackPanel Style="{StaticResource AboutRow}">
                            <TextBlock Text="{Binding [License], Source={StaticResource Lang}}" Style="{StaticResource AboutLabel}"/>
                            <TextBlock Text="{Binding [LicenseText], Source={StaticResource Lang}}" Style="{StaticResource AboutValue}"
                                    TextWrapping="Wrap" MaxWidth="280"/>
                        </StackPanel>

                                <!-- لینک گیت‌هاب -->
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="{Binding [GitHub], Source={StaticResource Lang}}" 
                                    Style="{StaticResource AboutLabel}"/>
                            <Button Click="OpenGitHub_Click" 
                                    ToolTip="{Binding [OpenGitHub], Source={StaticResource Lang}}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Padding="0" Margin="0">
                                <TextBlock Foreground="{StaticResource AccentBlueBrush}" 
                                        FontSize="12" FontWeight="Medium"
                                        TextDecorations="Underline">
                                    github.com/ip2300-p/SFE-Secure-File-Encoder-
                                </TextBlock>
                            </Button>
                        </StackPanel>
                        
                        <!-- جداکننده -->
                        <Border Background="{StaticResource SurfaceOverlayBrush}" Height="1" Margin="0,10"/>
                        
                        <!-- فوتر -->
                        <TextBlock Text="{Binding [Credits], Source={StaticResource Lang}}"
                                Style="{StaticResource MutedStyle}" 
                                HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
        </StackPanel>
    </ScrollViewer>
</Window>