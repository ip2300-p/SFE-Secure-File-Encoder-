<Window x:Class="SFE.UI.Views.MainWindow"
        FlowDirection="{Binding [IsRTL], Source={StaticResource Lang}, Converter={StaticResource RtlFlow}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SFE.UI"
        Title="{Binding [AppTitle], Source={StaticResource Lang}}"
        Height="760" Width="1040" MinHeight="680" MinWidth="880"
        Background="{StaticResource SurfaceCrustBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
        

    <Window.Resources>
        <ObjectDataProvider x:Key="Lang" ObjectType="{x:Type local:LangProvider}" MethodName="get_Instance"/>
        <local:FileSizeConverter x:Key="FileSizeConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════════════ HEADER ════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                          Fill="{StaticResource AccentBlueBrush}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding [AppTitle], Source={StaticResource Lang}}" Style="{StaticResource TitleStyle}"/>
                </StackPanel>
                <TextBlock Text="{Binding [AppSubtitle], Source={StaticResource Lang}}" Style="{StaticResource MutedStyle}"  Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource HeaderBtn}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.49,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.51,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.51,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.49,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                              Fill="{StaticResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding [Settings], Source={StaticResource Lang}}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenScenariosCommand}" Style="{StaticResource HeaderBtn}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M7,7H17V9H7V7M17,11V13H7V11H17M14,15V17H7V15H14Z"
                              Fill="{StaticResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding [Scenarios], Source={StaticResource Lang}}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ════════════════ SEGMENTED MODE ════════════════ -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceMantleBrush}" CornerRadius="8" Padding="4" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding SetEncryptModeCommand}" Style="{StaticResource EncryptTabBtn}" Height="42" Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                              Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,3,0"/>
                        <TextBlock Text="{Binding [ModeEncrypt], Source={StaticResource Lang}}"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Command="{Binding SetDecryptModeCommand}" Style="{StaticResource DecryptTabBtn}" Height="42" Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10A2,2 0 0,1 6,8H15V6A3,3 0 0,0 12,3C10.6,3 9.39,3.96 9.07,5.26L7.13,4.5C7.75,2.44 9.7,1 12,1A5,5 0 0,1 17,6V8H18Z"
                              Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,3,0"/>
                        <TextBlock Text="{Binding [ModeDecrypt], Source={StaticResource Lang}}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ════════════════ MAIN WORKSPACE ════════════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <!-- ──── LEFT: Drop Zone & Files ──── -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0" AllowDrop="True" Drop="DropArea_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Drop Zone with Dynamic Border -->
                    <Border Grid.Row="0" BorderThickness="1.5" CornerRadius="8" Background="{StaticResource BlueTintBrush}" Padding="20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEncryptMode}" Value="False">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                        <Setter Property="Background" Value="{StaticResource GreenTintBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21V18A2,2 0 0,1 19,20Z"
                                  Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{StaticResource AccentBlueBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEncryptMode}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding [DropHere], Source={StaticResource Lang}}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"  TextAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <Button Command="{Binding SelectFilesCommand}" Style="{StaticResource ActionBtn}"  Margin="0,0,8,0" Height="36" FontSize="12" Padding="14,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding [SelectFile], Source={StaticResource Lang}}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SelectFolderCommand}" Style="{StaticResource SecondaryBtn}"  Height="36" FontSize="12">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" Fill="{StaticResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding [SelectFolder], Source={StaticResource Lang}}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- File List -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" >
                                <TextBlock Text="{Binding [SelectedFilesList], Source={StaticResource Lang}}" Style="{StaticResource SupportingStyle}"/>
                                <TextBlock Text="{Binding FileCountText}" Style="{StaticResource SupportingStyle}"
                                        Foreground="{StaticResource AccentBlueBrush}" FontWeight="Bold" Margin="6,0,0,0"/>
                            </StackPanel>
                            <Button Command="{Binding ClearFilesCommand}" Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Right" Padding="8,4" Height="28" FontSize="11">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Fill="{StaticResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding [ClearFiles], Source={StaticResource Lang}}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding SelectedPaths}" Background="Transparent" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceOverlayBrush}" CornerRadius="6" Padding="8,6" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2Z"
                                                  Fill="{StaticResource AccentBlueBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip="{Binding Converter={StaticResource FileSizeConv}}"/>
                                            <Grid Grid.Column="2" Margin="4,0,0,0" Width="16" Height="16">
                                                <!-- 🗑 حذف (فقط قبل از عملیات) -->
                                                <Button Click="RemoveFile_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0">
                                                    <Button.Visibility>
                                                        <MultiBinding Converter="{StaticResource FileStatusVis}" ConverterParameter="Trash">
                                                            <Binding Path="."/>
                                                            <Binding Path="DataContext.FileStatusVersion" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                        </MultiBinding>
                                                    </Button.Visibility>
                                                    <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                        Fill="{StaticResource AccentRedBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                                </Button>
                                                <!-- ⏳ در صف / در حال پردازش -->
                                                <Path Data="M12,2A10,10 0 1,0 22,12A10,10 0 0,0 12,2M12.5,7H11V13L16.2,16.2L17,14.9L12.5,12.2V7Z"
                                                    Fill="{StaticResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path.Visibility>
                                                        <MultiBinding Converter="{StaticResource FileStatusVis}" ConverterParameter="Clock">
                                                            <Binding Path="."/>
                                                            <Binding Path="DataContext.FileStatusVersion" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                        </MultiBinding>
                                                    </Path.Visibility>
                                                </Path>
                                                <!-- ✅ موفق -->
                                                <Path Data="M12,2C6.5,2 2,6.5 2,12S6.5,22 12,22 22,17.5 22,12 17.5,2 12,2M10,17L5,12L6.4,10.6L10,14.2L17.6,6.6L19,8L10,17Z"
                                                    Fill="{StaticResource AccentGreenBrush}" Width="12" Height="12" Stretch="Uniform"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path.Visibility>
                                                        <MultiBinding Converter="{StaticResource FileStatusVis}" ConverterParameter="Check">
                                                            <Binding Path="."/>
                                                            <Binding Path="DataContext.FileStatusVersion" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                        </MultiBinding>
                                                    </Path.Visibility>
                                                </Path>
                                                <!-- ❌ ناموفق -->
                                                <Path Data="M12,2C6.5,2 2,6.5 2,12S6.5,22 12,22 22,17.5 22,12 17.5,2 12,2M12,10.6L9.9,8.5L8.5,9.9L10.6,12L8.5,14.1L9.9,15.5L12,13.4L14.1,15.5L15.5,14.1L13.4,12L15.5,9.9L14.1,8.5L12,10.6Z"
                                                    Fill="{StaticResource AccentRedBrush}" Width="12" Height="12" Stretch="Uniform"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path.Visibility>
                                                        <MultiBinding Converter="{StaticResource FileStatusVis}" ConverterParameter="Cross">
                                                            <Binding Path="."/>
                                                            <Binding Path="DataContext.FileStatusVersion" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                        </MultiBinding>
                                                    </Path.Visibility>
                                                </Path>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- ──── RIGHT: Config Side ──── -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,16">
                            <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1Z" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{StaticResource AccentBlueBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEncryptMode}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding [SecuritySettings], Source={StaticResource Lang}}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Primary Password -->
                        <TextBlock Text="{Binding [MainPassword], Source={StaticResource Lang}}" Style="{StaticResource LabelStyle}"  Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <PasswordBox x:Name="TxtPassword" PasswordChanged="PasswordBox_PasswordChanged" Height="36"/>
                            <TextBox x:Name="TxtPasswordVisible" Height="36" Visibility="Collapsed"/>
                            <Button x:Name="BtnToggleShowPass" Click="TogglePasswordVisibility_Click" HorizontalAlignment="Right" Width="30" Height="30" Margin="0,0,3,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Path Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"
                                      Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                        <ProgressBar Value="{Binding PasswordStrength, Mode=OneWay}" Maximum="4" Height="4" Margin="0,2,0,16" Foreground="{Binding PasswordStrengthBrush}"/>

                        <!-- Second Layer Password (Dynamic Visibility) -->
                        <StackPanel Visibility="{Binding ShowSecondPassword, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                            <TextBlock Text="{Binding [SecondPassword], Source={StaticResource Lang}}" FontSize="12" Foreground="{StaticResource AccentYellowBrush}"  Margin="0,0,0,6"/>
                            <PasswordBox x:Name="TxtSecondPassword" PasswordChanged="TxtSecondPassword_PasswordChanged" Height="36"/>
                            <TextBlock Text="{Binding [SecondPasswordInfo], Source={StaticResource Lang}}"
                                    Style="{StaticResource MutedStyle}" 
                                    TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>

                        <!-- Output Path -->
                        <TextBlock Text="{Binding [OutputFolder], Source={StaticResource Lang}}" Style="{StaticResource LabelStyle}"  Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OutputDirectory}" IsReadOnly="True" Height="36" Background="{StaticResource SurfaceOverlayBrush}"/>
                            <TextBlock Text="{Binding [OutputHint], Source={StaticResource Lang}}"
                                    Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                    VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OutputDirectory}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="1" Command="{Binding SelectOutputCommand}" Style="{StaticResource IconBtn}" Width="38" Height="36" Margin="6,0,0,0">
                                <Path Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21V18A2,2 0 0,1 19,20Z"
                                      Fill="{StaticResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <!-- Action Button -->
                        <Button Content="{Binding ActionButtonText}" Command="{Binding ExecuteCommand}" Style="{StaticResource ActionBtn}" Height="42" Padding="16,0" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ════════════════ STATUS BAR ════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,10">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Grid.Column="1" Content="{Binding [OpenFolder], Source={StaticResource Lang}}"
                        Command="{Binding OpenOutputFolderCommand}"
                        Visibility="{Binding ShowOpenFolder, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource LinkBtn}" Margin="12,0,0,0"/>
                <TextBlock Grid.Column="2" Text="{Binding CurrentFile}" FontSize="11"
                        Foreground="{StaticResource TextMutedBrush}"
                        TextTrimming="CharacterEllipsis" Margin="12,0,12,0"
                        FlowDirection="LeftToRight"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Text="{Binding SpeedText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding EtaText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>
                <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="4"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>